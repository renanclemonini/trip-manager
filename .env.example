DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=core.settings.dev
POSTGRES_DB=trip_manager
POSTGRES_USER=trip_manager
POSTGRES_PASSWORD=trip_manager
POSTGRES_HOST=db
POSTGRES_PORT=5432

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Gerenciador de Viagem <no-reply@trip-manager.local>

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Produção (Docker Swarm — docker-stack.yml)
DJANGO_ALLOWED_HOSTS=trip.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://trip.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
# Para testar em HTTP puro (sem TLS na frente):
# DJANGO_SECURE_SSL_REDIRECT=false
